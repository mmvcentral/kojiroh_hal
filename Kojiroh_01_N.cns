; 引き分け
[Statedef 175]
type = S
ctrl = 0
anim = 175
velset = 0,0

[State 175, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; 勝利分岐
[Statedef 180]
type = S

[State 180, 0]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 180, 1]
type = ChangeState
triggerall = Var(10) > 0
trigger1 = Time = 20
trigger1 = MatchOver || TeamMode = Turns
trigger2 = Time = 70
value = 189

[State 180, 2]
type = Helper
triggerall = Var(10) = 0
triggerall = NumHelper(18000) = 0
trigger1 = MatchOver = 1
trigger2 = Time = 70
trigger3 = TeamMode = Turns
trigger3 = MatchOver = 0
trigger3 = Time = 60
id = 18000
stateno = 18000
pos = 0,0
keyctrl = 0

[State 180, 3]
type = ChangeState
trigger1 = MatchOver = 0
trigger1 = Time = 70
value = 181

[State 180, 4]
type = ChangeState
triggerall = MatchOver = 1
triggerall = Time = 20
trigger1 = Enemy(0),Name = "washizuka"
trigger2 = Enemy(0),Name = "sanada_ani"
trigger3 = NumEnemy >= 2
trigger3 = Enemy(0),Name = "washizuka" || Enemy(1),Name = "washizuka"
trigger4 = NumEnemy >= 2
trigger4 = Enemy(0),Name = "sanada_ani" || Enemy(1),Name = "sanada_ani"
value = 184

[State 180, 5]
type = ChangeState
triggerall = MatchOver = 1
triggerall = Time = 20
trigger1 = Enemy(0),Name = "Mukuro"
trigger2 = NumEnemy >= 2
trigger2 = Enemy(0),Name = "Mukuro" || Enemy(1),Name = "Mukuro"
value = 185

[State 180, 6]
type = ChangeState
trigger1 = MatchOver = 1
trigger1 = Time = 20
trigger1 = Var(1) = 0
value = 182

[State 180, 7]
type = ChangeState
trigger1 = MatchOver = 1
trigger1 = Time = 20
trigger1 = Var(1) != 0
value = 183

