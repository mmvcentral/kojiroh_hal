;---------------------------------------------------------------------------
; Rouga-Rei effect helper
;---------------------------------------------------------------------------
[Statedef 53000]
type     = A
movetype = I
physics  = N
velset = 0,0
anim = 53000
ctrl = 0
sprpriority = 2

[State 53000, 1]
type = AssertSpecial
trigger1 = 1
flag = NoShadow
ignorehitpause = 1

[State 53000, 2]
type = AssertSpecial
trigger1 = GameTime%2 = 0
flag = Invisible
ignorehitpause = 1

[State 53000, 3]
type = VelSet
trigger1 = Time = 0
x = 21

[State 53000, 4]
type = VelSet
trigger1 = Vel X > 0
trigger1 = AnimElemTime(8) <= 0
x = (Vel X - 1)

[State 53000, 5]
type = VelSet
trigger1 = AnimElemTime(8) > 0
x = 0

[State 51100, 6]
type = SprPriority
trigger1 = 1
value = 3

[State 53000, 7]
type = DestroySelf
trigger1 = AnimTime = 0

;---------------------------------------------------------------------------
; Stage edge measurement helper (forward)
;---------------------------------------------------------------------------
[Statedef 100000]
type     = A
movetype = I
physics  = N
velset = IfElse(RoundState=2,30,10),0
anim = 0
ctrl = 0

[State 100000]
type = SelfState
trigger1 = !IsHelper
value = 0

[State 100000]
type = AssertSpecial
trigger1 = IsHelper
flag  = Invisible
flag2 = NoShadow
ignorehitpause = 1

[State 100000]
type = NotHitBy
trigger1 = 1
value = SCA
ignorehitpause = 1

[State 100000]
type = Varset
trigger1 = Time = 0
var(0) = 0

[State 100000]
type = Projectile
trigger1 = Time = 0
trigger1 = NumProjID(100000) < 1
projID = 100000
projanim = 10000
projstagebound = Const(size.ground.front)*-2
projedgebound = 100000
projremovetime = -1
projpriority = 9999
velocity = IfElse(RoundState=2,30,10),0
offset = 0,0
supermovetime = 99999999
pausemovetime = 99999999

[State 100000]
type = VelSet
trigger1 = Vel X > 0
trigger1 = Root,NumProjID(100000) = 0
x = 0

[State 100000]
type = VarSet
trigger1 = Time > 0
trigger1 = Vel X = 0
trigger1 = NumHelper(100000) > 0
trigger1 = Root,NumProjID(100000) = 0
var(0) = Ceil(RootDist X)

[State 100000]
type = DestroySelf
trigger1 = Time > 0
trigger1 = Var(0)
trigger1 = NumHelper(10000) > 0
trigger1 = Helper(10000),Var(0)

