; Sword style selection (Power)
[Statedef 10190]
type     = A
movetype = I
physics  = N
ctrl = 0
anim = 10190
velset = 0,0
sprpriority = 10

[State 10190, 1]
type = AssertSpecial
trigger1 = 1
flag  = Intro
flag2 = NoShadow

[State 10190, 2]
type = Changestate
trigger1 = RoundState = 2
trigger2 = Root,Time >= 300
trigger3 = Command = "a"
trigger4 = Command = "b"
trigger5 = Command = "start"
trigger6 = Root,Var(1) = 0
trigger6 = Root,Var(57) = 1
value = 10195

; Power -> Technique
[State 10190, 3]
type = ParentVarSet
trigger1 = Command = "fwd"
trigger2 = Command = "back"
trigger3 = Root,Var(57) = 2
var(1) = 1

[State 10190, 4]
type = ChangeState
trigger1 = Root,Var(1) = 1
value = 10191

; Extreme sword style hidden command
[State 10190, 5]
type = VarSet
trigger1 = Command = "down"
trigger1 = Var(1) != [6,8]
var(1) = 0

[State 10190, 6]
type = VarAdd
trigger1 = Command = "down"
trigger1 = Var(1) = [6,8]
var(1) = 1

[State 10190, 7]
type = VarSet
trigger1 = Command = "up"
trigger2 = Var(2) = 240
var(1) = 0

[State 10190, 8]
type = VarAdd
trigger1 = Var(1) > 0
var(2) = 1

[State 10190, 9]
type = VarSet
trigger1 = Var(1) = 0
trigger2 = Var(2) > 240
var(2) = 0

