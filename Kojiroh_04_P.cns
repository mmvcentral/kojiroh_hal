; Charge time measurement (guard break, Rouga-Rei)
[State 10000, Charge_1]
type = VarSet
triggerall = Root,Time = 0
trigger1 = Root,StateNo = 260
trigger2 = Root,StateNo = 3000
v = 10
value = 0
ignorehitpause = 1

[State 10000, Charge_2]
type = VarSet
triggerall = Var(10) > 0
trigger1  = Root,StateNo = 261 || Root,StateNo = 260 && Root,AnimElemTime(12) > 0
trigger2  = Root,StateNo = 3010 || Root,StateNo = 3000 && Root,AnimElemTime(19) > 0
trigger3  = Root,MoveType = H || Root,StateType = L
trigger4  = Root,Command = "2146+B" || Root,Command = "2146+AB"
trigger5  = Root,Command = "22+A" || Root,Command = "22+B"
trigger6  = Root,Command = "412+A" || Root,Command = "412+B" || Root,Command = "412+C"
trigger7  = Root,Command = "623+A" || Root,Command = "623+B"
trigger8  = Root,Command = "214+A" || Root,Command = "214+B" || Root,Command = "214+C"
trigger9  = Root,Command = "236+A" || Root,Command = "236+B" || Root,Command = "412+X"
trigger10 = Root,StateNo = 260 && Root,AnimElemTime(12) < 0
trigger10 = Root,Command != "hold_b" && Root,Command != "hold_c" && Root,Command != "holdz"
trigger11 = Root,StateNo = 3000 && Root,AnimElemTime(19) < 0
trigger11 = Root,Command != "hold_b"
v = 10
value = 0
ignorehitpause = 1

[State 10000, Charge_3]
type = VarAdd
trigger1 = Root,StateNo = 260 && Root,AnimElemTime(12) < 0
trigger1 = Root,Command = "hold_b" && Root,Command = "hold_c" || Root,Command = "holdz"
trigger2 = Root,StateNo = 3000 && Root,AnimElemTime(19) < 0
trigger2 = Root,Command = "hold_b"
v = 10
value = 1
ignorehitpause = 1

