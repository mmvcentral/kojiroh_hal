;挙動確認
[State -2, DisplayToClipboard]
type = DisplayToClipboard
trigger1 = 1
text = "Vel X:%f Vel Y:%f Pos Y:%d  V(4)=%d  V(25)=%d"
params = Vel X, Vel Y, Floor(Pos Y), Var(4), Var(25)
ignorehitpause = 1

